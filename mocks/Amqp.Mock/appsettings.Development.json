            "Value": "hello",
            "Response": "Hello World!"
          },
          {
            "Type": "regex",
            "Value": "\\d+",
            "Response": "Hello World Regex!"
          }
        ]
      },
      {
        "ExchangeOrigin": "mock.exchange.origin.A",
        "ExchangeTypeOrigin": "direct",
        "QueueOrigin": "mock.queue.A",
        "ExchangeDestination": "mock.exchange.destination.A",
        "ExchangeTypeDestination": "direct",
